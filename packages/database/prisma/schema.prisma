generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ResourceLifecycleState {
  ACTIVE
  ARCHIVED
}

enum ResourceVersionState {
  DRAFT
  SUBMITTED
  IN_REVIEW
  DECLINED
  APPROVED
}

enum AssetScanStatus {
  PENDING
  CLEAN
  REJECTED
  FAILED
}

enum ResourceAssetPurpose {
  PRIMARY_DOCUMENT
  DOWNLOAD
  IMAGE
  CAPTION
  TRANSCRIPT
  SUPPORTING_DOCUMENT
}

enum ConsentWithdrawalStatus {
  REQUESTED
  PROCESSED
}

enum VerificationType {
  ORIGINAL_SOURCE
  EXTERNAL_OPPORTUNITY
  SOURCE_REVERIFICATION
}

enum VerificationOutcome {
  VERIFIED
  FAILED
  INCONCLUSIVE
}

enum ReviewRoundState {
  PENDING_ASSIGNMENT
  IN_REVIEW
  RETURNED_FOR_CHANGES
  COMPLETED
}

enum ReviewDecisionOutcome {
  APPROVE
  DECLINE
}

enum ReviewRoundActionType {
  RETURNED_FOR_CHANGES
  REASSIGNED
  ASSIGNMENT_RELEASED
}

enum SpecialistReviewStatus {
  REQUIRED
  IN_PROGRESS
  COMPLETED
}

enum SpecialistReviewOutcome {
  SATISFIED
  NOT_SATISFIED
  NOT_APPLICABLE
}

enum PublicationAttemptOutcome {
  SUCCEEDED
  FAILED
}

enum RestorationCaseState {
  REQUESTED
  IN_REVIEW
  COMPLETED
  DECLINED
}

enum DeletionCaseOutcome {
  EXECUTED
  DECLINED
  CANCELLED
}

enum IdentityVisibility {
  NAMED
  FIRST_NAME_ONLY
  ANONYMOUS
  DE_IDENTIFIED
}

enum WorkArrangement {
  ONSITE
  REMOTE
  HYBRID
}

model AuditEvent {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  eventType String? @map("event_type")

  actorId   String? @map("actor_id")
  actorType String? @map("actor_type")

  resourceId        String? @map("resource_id") @db.Uuid
  resourceVersionId String? @map("resource_version_id") @db.Uuid

  targetType String? @map("target_type")
  targetId   String? @map("target_id")

  reason String?

  correlationId String? @map("correlation_id") @db.Uuid
  requestId     String? @map("request_id") @db.Uuid

  beforeContext Json? @map("before_context")
  afterContext  Json? @map("after_context")
  metadata      Json?

  // Legacy Phase 1 compatibility fields.
  action     String?
  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  resourceVersion ResourceVersion? @relation(fields: [resourceId, resourceVersionId], references: [resourceId, id], onDelete: Restrict)

  @@index([occurredAt])
  @@index([actorId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([resourceId, occurredAt])
  @@index([resourceVersionId, occurredAt])
  @@index([targetType, targetId, occurredAt])
  @@index([correlationId])
  @@index([requestId])
  @@map("audit_events")
}

model ResourceType {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalKey String  @unique @map("canonical_key")
  name         String
  description  String?

  parentId String?        @map("parent_id") @db.Uuid
  parent   ResourceType?  @relation("ResourceTypeHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children ResourceType[] @relation("ResourceTypeHierarchy")

  resourceVersions ResourceVersion[]

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([isActive])
  @@map("resource_types")
}

model ContentFormat {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalKey String  @unique @map("canonical_key")
  name         String
  description  String?

  resourceVersions ResourceVersion[]

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("content_formats")
}

model Topic {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalKey String  @unique @map("canonical_key")
  name         String
  description  String?

  resourceVersions ResourceVersionTopic[]

  parentId String? @map("parent_id") @db.Uuid
  parent   Topic?  @relation("TopicHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Topic[] @relation("TopicHierarchy")

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([isActive])
  @@map("topics")
}

model Geography {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalKey String  @unique @map("canonical_key")
  name         String
  description  String?

  resourceVersions ResourceVersionGeography[]

  parentId String?     @map("parent_id") @db.Uuid
  parent   Geography?  @relation("GeographyHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Geography[] @relation("GeographyHierarchy")

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentId])
  @@index([isActive])
  @@map("geographies")
}

model Population {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalKey String  @unique @map("canonical_key")
  name         String
  description  String?

  resourceVersions ResourceVersionPopulation[]

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("populations")
}

model Audience {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalKey String  @unique @map("canonical_key")
  name         String
  description  String?

  resourceVersions ResourceVersionAudience[]

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("audiences")
}

model Sector {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalKey String  @unique @map("canonical_key")
  name         String
  description  String?

  resourceVersions ResourceVersionSector[]

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive])
  @@map("sectors")
}

model UserAccount {
  id              String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  externalSubject String? @unique @map("external_subject")
  displayName     String? @map("display_name")

  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(6)

  createdResources        Resource[]          @relation("ResourceCreator")
  createdResourceVersions ResourceVersion[]   @relation("ResourceVersionCreator")
  verificationEvents      VerificationEvent[] @relation("VerificationEventVerifier")

  sourceApprovals SourceApproval[] @relation("SourceApprovalApprover")

  createdAssets Asset[] @relation("AssetCreator")

  formalReviewAssignments ReviewerAssignment[] @relation("FormalReviewer")

  reviewAssignmentsMade ReviewerAssignment[] @relation("ReviewerAssignmentAssigner")

  reviewDecisions ReviewDecision[] @relation("ReviewDecisionReviewer")

  reviewRoundActions ReviewRoundAction[] @relation("ReviewRoundActionActor")

  specialistReviewChecks SpecialistReviewCheck[] @relation("SpecialistReviewer")

  reviewChecklistResponses ReviewChecklistResponse[] @relation("ChecklistResponseReviewer")

  publicationRequests PublicationRequest[] @relation("PublicationRequestRequester")

  publicationSchedules PublicationSchedule[] @relation("PublicationScheduleCreator")

  publicationAttempts PublicationAttempt[] @relation("PublicationAttemptActor")

  publicationWithdrawals PublicationWithdrawal[] @relation("PublicationWithdrawalActor")

  archiveEvents ArchiveEvent[] @relation("ArchiveEventActor")

  restorationRequests RestorationCase[] @relation("RestorationRequester")

  deletionRequests DeletionCase[] @relation("DeletionRequester")

  deletionApprovals DeletionCase[] @relation("DeletionApprover")

  deletionExecutions DeletionCase[] @relation("DeletionExecutor")

  createdConsentRecords       ConsentRecord[]     @relation("ConsentRecordCreator")
  recordedConsentPermissions  ConsentPermission[] @relation("ConsentPermissionRecorder")
  requestedConsentWithdrawals ConsentWithdrawal[] @relation("ConsentWithdrawalRequester")
  processedConsentWithdrawals ConsentWithdrawal[] @relation("ConsentWithdrawalProcessor")

  @@index([isActive])
  @@map("user_accounts")
}

model Resource {
  id             String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalSlug  String                 @unique @map("canonical_slug")
  lifecycleState ResourceLifecycleState @default(ACTIVE) @map("lifecycle_state")

  createdByUserId String      @map("created_by_user_id") @db.Uuid
  createdBy       UserAccount @relation("ResourceCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  currentPublishedVersionId String?          @unique @map("current_published_version_id") @db.Uuid
  currentPublishedVersion   ResourceVersion? @relation("CurrentPublishedVersion", fields: [id, currentPublishedVersionId], references: [resourceId, id], onDelete: Restrict)

  publicationWithdrawals PublicationWithdrawal[]
  archiveEvents          ArchiveEvent[]
  restorationCases       RestorationCase[]
  deletionCases          DeletionCase[]

  auditEvents        AuditEvent[]
  verificationEvents VerificationEvent[]
  versions           ResourceVersion[]   @relation("ResourceVersions")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  @@unique([id, currentPublishedVersionId])
  @@index([lifecycleState])
  @@index([createdByUserId])
  @@map("resources")
}

model ResourceVersion {
  id         String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  resourceId String @map("resource_id") @db.Uuid

  resource Resource @relation("ResourceVersions", fields: [resourceId], references: [id], onDelete: Restrict)

  publishedForResource Resource? @relation("CurrentPublishedVersion")

  versionNumber Int                  @map("version_number")
  state         ResourceVersionState @default(DRAFT)

  predecessorVersionId String?          @map("predecessor_version_id") @db.Uuid
  predecessor          ResourceVersion? @relation("ResourceVersionLineage", fields: [resourceId, predecessorVersionId], references: [resourceId, id], onDelete: Restrict)

  successors ResourceVersion[] @relation("ResourceVersionLineage")

  title                String
  plainLanguageSummary String @map("plain_language_summary")

  publicationDate DateTime? @map("publication_date") @db.Date
  expirationAt    DateTime? @map("expiration_at") @db.Timestamptz(6)

  resourceTypeId String       @map("resource_type_id") @db.Uuid
  resourceType   ResourceType @relation(fields: [resourceTypeId], references: [id], onDelete: Restrict)

  contentFormatId String        @map("content_format_id") @db.Uuid
  contentFormat   ContentFormat @relation(fields: [contentFormatId], references: [id], onDelete: Restrict)

  createdByUserId String      @map("created_by_user_id") @db.Uuid
  createdBy       UserAccount @relation("ResourceVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)

  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(6)

  lockVersion Int @default(0) @map("lock_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  researchPublicationDetails ResearchPublicationDetails?
  datasetDetails             DatasetDetails?
  livedExperienceDetails     LivedExperienceDetails?
  programEventDetails        ProgramEventDetails?
  opportunityDetails         OpportunityDetails?
  auditEvents                AuditEvent[]
  reviewRounds               ReviewRound[]
  verificationEvents         VerificationEvent[]
  authors                    ResourceVersionAuthor[]
  sources                    ResourceVersionSource[]
  assets                     ResourceVersionAsset[]

  topics      ResourceVersionTopic[]
  geographies ResourceVersionGeography[]
  populations ResourceVersionPopulation[]
  audiences   ResourceVersionAudience[]
  sectors     ResourceVersionSector[]

  publicationRequests    PublicationRequest[]
  publicationSchedules   PublicationSchedule[]
  publicationAttempts    PublicationAttempt[]
  publicationWithdrawals PublicationWithdrawal[]

  @@unique([resourceId, versionNumber])
  @@unique([resourceId, id])
  @@index([resourceId, state])
  @@index([resourceTypeId])
  @@index([contentFormatId])
  @@index([predecessorVersionId])
  @@index([createdByUserId])
  @@map("resource_versions")
}

model ResourceVersionTopic {
  resourceVersionId String @map("resource_version_id") @db.Uuid
  topicId           String @map("topic_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)
  topic           Topic           @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@id([resourceVersionId, topicId])
  @@index([topicId])
  @@map("resource_version_topics")
}

model ResourceVersionGeography {
  resourceVersionId String @map("resource_version_id") @db.Uuid
  geographyId       String @map("geography_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)
  geography       Geography       @relation(fields: [geographyId], references: [id], onDelete: Restrict)

  @@id([resourceVersionId, geographyId])
  @@index([geographyId])
  @@map("resource_version_geographies")
}

model ResourceVersionPopulation {
  resourceVersionId String @map("resource_version_id") @db.Uuid
  populationId      String @map("population_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)
  population      Population      @relation(fields: [populationId], references: [id], onDelete: Restrict)

  @@id([resourceVersionId, populationId])
  @@index([populationId])
  @@map("resource_version_populations")
}

model ResourceVersionAudience {
  resourceVersionId String @map("resource_version_id") @db.Uuid
  audienceId        String @map("audience_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)
  audience        Audience        @relation(fields: [audienceId], references: [id], onDelete: Restrict)

  @@id([resourceVersionId, audienceId])
  @@index([audienceId])
  @@map("resource_version_audiences")
}

model ResourceVersionSector {
  resourceVersionId String @map("resource_version_id") @db.Uuid
  sectorId          String @map("sector_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)
  sector          Sector          @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  @@id([resourceVersionId, sectorId])
  @@index([sectorId])
  @@map("resource_version_sectors")
}

model ResearchPublicationDetails {
  resourceVersionId String @id @map("resource_version_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)

  publisherOrganizationId String?       @map("publisher_organization_id") @db.Uuid
  publisherOrganization   Organization? @relation("ResearchPublisher", fields: [publisherOrganizationId], references: [id], onDelete: Restrict)

  keyFindings        String?  @map("key_findings")
  policyImplications String?  @map("policy_implications")
  peerReviewed       Boolean? @map("peer_reviewed")

  @@index([publisherOrganizationId])
  @@map("research_publication_details")
}

model ResourceVersionAuthor {
  id                String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  resourceVersionId String @map("resource_version_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation("AuthorOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  displayName String @map("display_name")
  sequence    Int    @default(0)

  @@unique([resourceVersionId, sequence])
  @@index([resourceVersionId])
  @@index([organizationId])
  @@map("resource_version_authors")
}

model DatasetDetails {
  resourceVersionId String @id @map("resource_version_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)

  sourceOrganizationId String?       @map("source_organization_id") @db.Uuid
  sourceOrganization   Organization? @relation("DatasetSourceOrganization", fields: [sourceOrganizationId], references: [id], onDelete: Restrict)

  indicators DatasetIndicator[]

  referencePeriodStart DateTime? @map("reference_period_start") @db.Date
  referencePeriodEnd   DateTime? @map("reference_period_end") @db.Date

  methodologyNote String?  @map("methodology_note")
  downloadAllowed Boolean? @map("download_allowed")

  @@index([sourceOrganizationId])
  @@map("dataset_details")
}

model LivedExperienceDetails {
  resourceVersionId String @id @map("resource_version_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)

  identityVisibility IdentityVisibility @map("identity_visibility")

  consentRecordId String        @map("consent_record_id") @db.Uuid
  consentRecord   ConsentRecord @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)

  @@index([consentRecordId])
  @@map("lived_experience_details")
}

model ProgramEventDetails {
  resourceVersionId String @id @map("resource_version_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)

  partnerOrganizationId String?       @map("partner_organization_id") @db.Uuid
  partnerOrganization   Organization? @relation("ProgramPartner", fields: [partnerOrganizationId], references: [id], onDelete: Restrict)

  startsAt        DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt          DateTime? @map("ends_at") @db.Timestamptz(6)
  locationText    String?   @map("location_text")
  virtualUrl      String?   @map("virtual_url")
  registrationUrl String?   @map("registration_url")

  @@index([partnerOrganizationId])
  @@map("program_event_details")
}

model OpportunityDetails {
  resourceVersionId String @id @map("resource_version_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)

  applicationDeadlineAt DateTime?        @map("application_deadline_at") @db.Timestamptz(6)
  compensationText      String?          @map("compensation_text")
  workArrangement       WorkArrangement? @map("work_arrangement")
  applicationUrl        String?          @map("application_url")

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation("OpportunityOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@map("opportunity_details")
}

model OrganizationType {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalKey String  @unique @map("canonical_key")
  name         String
  description  String?

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organizations Organization[]

  @@index([isActive])
  @@map("organization_types")
}

model Organization {
  id            String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalName String  @map("canonical_name")
  canonicalKey  String? @unique @map("canonical_key")
  websiteUrl    String? @map("website_url")

  organizationTypeId String?           @map("organization_type_id") @db.Uuid
  organizationType   OrganizationType? @relation(fields: [organizationTypeId], references: [id], onDelete: Restrict)

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  originalSources       OriginalSource[]
  dataSharingAgreements DataSharingAgreement[]
  publicationDetails    ResearchPublicationDetails[] @relation("ResearchPublisher")
  datasetDetails        DatasetDetails[]             @relation("DatasetSourceOrganization")
  programEventDetails   ProgramEventDetails[]        @relation("ProgramPartner")
  opportunityDetails    OpportunityDetails[]         @relation("OpportunityOrganization")
  authorAffiliations    ResourceVersionAuthor[]      @relation("AuthorOrganization")

  @@index([organizationTypeId])
  @@index([canonicalName])
  @@index([isActive])
  @@map("organizations")
}

model SourceCategory {
  id           String  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  canonicalKey String  @unique @map("canonical_key")
  name         String
  description  String?

  isActive  Boolean   @default(true) @map("is_active")
  retiredAt DateTime? @map("retired_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  originalSources OriginalSource[]

  @@index([isActive])
  @@map("source_categories")
}

model OriginalSource {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  sourceCategoryId String?         @map("source_category_id") @db.Uuid
  sourceCategory   SourceCategory? @relation(fields: [sourceCategoryId], references: [id], onDelete: Restrict)

  title           String?
  sourceUrl       String? @map("source_url")
  sourceReference String? @map("source_reference")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  verificationEvents VerificationEvent[]
  resourceVersions   ResourceVersionSource[]
  approvals          SourceApproval[]

  @@index([organizationId])
  @@index([sourceCategoryId])
  @@map("original_sources")
}

model SourceApproval {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  originalSourceId String         @map("original_source_id") @db.Uuid
  originalSource   OriginalSource @relation(fields: [originalSourceId], references: [id], onDelete: Restrict)

  approvedByUserId String      @map("approved_by_user_id") @db.Uuid
  approvedBy       UserAccount @relation("SourceApprovalApprover", fields: [approvedByUserId], references: [id], onDelete: Restrict)

  approvedAt DateTime  @default(now()) @map("approved_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  notes      String?

  @@index([originalSourceId, approvedAt])
  @@index([approvedByUserId])
  @@map("source_approvals")
}

model ResourceVersionSource {
  resourceVersionId String @map("resource_version_id") @db.Uuid
  originalSourceId  String @map("original_source_id") @db.Uuid

  resourceVersion ResourceVersion @relation(fields: [resourceVersionId], references: [id], onDelete: Restrict)
  originalSource  OriginalSource  @relation(fields: [originalSourceId], references: [id], onDelete: Restrict)

  isPrimary    Boolean @default(false) @map("is_primary")
  citationText String? @map("citation_text")

  @@id([resourceVersionId, originalSourceId])
  @@index([originalSourceId])
  @@map("resource_version_sources")
}

model DataSharingAgreement {
  id String @id @default(dbgenerated("uuidv7()")) @db.Uuid

  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  agreementReference String @map("agreement_reference")

  effectiveDate  DateTime? @map("effective_date") @db.Date
  expirationDate DateTime? @map("expiration_date") @db.Date
