# -------------------------------------------------------------------
# BWES local development configuration
# -------------------------------------------------------------------

NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://bwes:bwes_local_dev@localhost:5432/bwes
TEST_DATABASE_URL=postgresql://bwes:bwes_local_dev@localhost:5432/bwes_test

# API
API_HOST=0.0.0.0
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# Web
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Directus
DIRECTUS_SECRET=replace-with-a-long-random-secret
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-strong-local-password
DIRECTUS_URL=http://localhost:8055

# S3-compatible object storage
S3_ACCESS_KEY=replace-with-local-access-key
S3_SECRET_KEY=replace-with-local-secret-key
S3_BUCKET=bwes-files
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1